# Fill these in yourself if you want to
# and make sure to change the file name from .env.example to .env

# Core app
APP_NAME=LocalChat
PORT=8000

# Database
DB_FILE_NAME=webchat.db

# Authentication / security
COOKIE_NAME=auth_token
JWT_SECRET_KEY=YOUR_GENERATED_32_CHARACTER_HEX_KEY
JWT_EXPIRES_IN=30
